{
  "name": "studio-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @studio/api dev",
    "worker": "pnpm --filter @studio/api worker",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @studio/api db:generate",
    "db:migrate": "pnpm --filter @studio/api db:migrate",
    "db:seed": "pnpm --filter @studio/api db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
