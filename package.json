{
  "name": "studio-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @studio/api dev",
    "worker": "pnpm --filter @studio/api worker",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @studio/api db:generate",
    "db:migrate": "pnpm --filter @studio/api db:migrate",
    "db:seed": "pnpm --filter @studio/api db:seed",
    "web": "pnpm --filter @studio/web dev",
    "e2e": "pnpm --filter @studio/web e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "exceljs>uuid": "^11.1.1"
    }
  }
}
