NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://studio:studio@localhost:5432/studio_dev
CORS_ORIGINS=http://localhost:5173
# Local only. Generate with: openssl rand -hex 32
AUTH_DEV_SECRET=replace-with-64-hex-characters-generated-locally-0000000000000000
EMAIL_PROVIDER=console
PUSH_PROVIDER=console
# Ads: encrypts stored ad platform tokens. Generate with: openssl rand -hex 32
# SECRETS_KEY=
# Meta Lead Ads webhooks (from your Meta app's settings)
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# WhatsApp inbox: Meta app id for Embedded Signup (uses META_APP_SECRET and META_VERIFY_TOKEN above)
# META_APP_ID=
# Message credit prices in US cents by country code and category, once the platform pays Meta for studios.
# Leave unset until then (studios can only pay Meta directly). Example: {"65":{"marketing":6.5,"utility":2.2}}
# WHATSAPP_RATE_CARD=
# Support assistant (Claude API). One platform key, server side only. Without it, the assistant
# says it isn't available and everything else works as normal.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# Replies included per studio per month (top-ups are bought on top)
# ASSISTANT_MONTHLY_REPLIES=300
# Kill switch for every studio at once
# ASSISTANT_DISABLED=false
# Production sign-in (all three required in production): your provider's JWKS address, and the
# issuer and audience its tokens carry. Tokens must also include email_verified for new sign-ups.
# AUTH_JWKS_URL=
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# How many load balancers sit in front of the API (1 for most hosts, 0 if none)
# TRUST_PROXY_HOPS=1
