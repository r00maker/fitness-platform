# Where the API is (no trailing slash).
VITE_API_URL=http://localhost:3000
# Sign-in: "supabase" (production) or "dev" (local only: any email, code 000000, via the API's /v1/dev/sign-in).
VITE_AUTH=dev
# Supabase Auth (when VITE_AUTH=supabase): the project's URL and its public anon key (safe in the browser).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=
