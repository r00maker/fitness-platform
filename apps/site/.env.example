# Where the free trial page signs people up. Copy to .env (git-ignored) or set these in the
# hosting provider's build settings. Left empty, the trial page is a preview that says so.

# "preview" keeps the trial page a preview even with the settings below; "live" (or unset) uses them.
SITE_TRIAL=
# The API's address (and add this site's address to the API's CORS_ORIGINS).
SITE_API_URL=
# The Supabase project the API trusts (its AUTH_JWKS_URL / AUTH_ISSUER point at the same project).
SITE_SUPABASE_URL=https://lezcugmdxretpofadjio.supabase.co
# The project's publishable key (sb_publishable_...). It's public by design. Never the secret or
# service-role key: the build refuses those.
SITE_SUPABASE_KEY=
# The studio app's address, for the "Open the studio app" button once the trial is ready.
SITE_STUDIO_APP_URL=
